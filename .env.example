# ===========================================
# VERTEX AI CONFIGURATION (Recommended)
# ===========================================
# Path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Region for Vertex AI (us-central1 is common)
GOOGLE_CLOUD_LOCATION=us-central1

# Enable Vertex AI mode
GOOGLE_GENAI_USE_VERTEXAI=true

# ===========================================
# ALTERNATIVE: AI Studio API Key (simpler but limited)
# ===========================================
# GEMINI_API_KEY=your_api_key_here

# ===========================================
# AUTO-LOOP: Claude API for automatic fixing
# ===========================================
# Get your key from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================
TARGET_URL=http://localhost:8501
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
MAX_ACTIONS_PER_STEP=50
STEP_TIMEOUT_SECONDS=30
